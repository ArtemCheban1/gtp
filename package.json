{
  "name": "guess-the-place",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local portal that turns 3 photos + a place into a 9:16 'Guess the Place' reel",
  "scripts": {
    "dev": "concurrently -n server,portal -c blue,green \"npm:server\" \"npm:portal\"",
    "server": "tsx watch --clear-screen=false server/index.ts",
    "portal": "vite",
    "studio": "remotion studio remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "validate-data": "tsx scripts/validate-data.ts",
    "make-sfx": "tsx scripts/make-sfx.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "d3-geo": "3.1.1",
    "express": "5.3.0",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/express": "5.0.6",
    "@types/geojson": "7946.0.16",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
